MONGO_URI=mongodb+srv://kaal:kaal123@machine.7vzoy0a.mongodb.net/?appName=machine
MONGO_DB_NAME=vsay-epm
CLOUDINARY_URL=cloudinary://783394936861218:CFyxF9HGVNws8YujLFlfEpsJdGQ@dblrqxs6d
RECONCILER_INTERVAL=1m
OFFLINE_TIMEOUT=2m
GIN_MODE=release

# Authentication is handled by vsay-auth gateway - no JWT secret needed in backend
# Gateway Secret for authenticating requests from vsay-auth (must match vsay-auth GATEWAY_SECRET)
# Where vsay-auth is reachable from this service, for the internal lookups
# that ask who administers a group. Leave unset and access requests fall back
# to whoever administers the organisation — which is how it worked before
# group administrators existed, so nothing breaks, it is just less specific.
AUTH_INTERNAL_URL=http://localhost:8080

GATEWAY_SECRET=vsay-gateway-super-secret-token-change-in-production-2026

# TLS Configuration
# TLS_ENABLED=false → HTTP on 8080 | true → HTTPS on 8443
TLS_ENABLED=false
# gRPC always uses mTLS (Private CA) — GRPC_MTLS_ENABLED is ignored
TLS_CERT_FILE=./certs/server-cert.pem
TLS_KEY_FILE=./certs/server-key.pem

# Private CA — signs agent client certs for mTLS
CA_CERT_FILE=./certs/ca-cert.pem
CA_KEY_FILE=./certs/ca-key.pem

# Domain for gRPC TLS cert SAN (used if auto-generating self-signed cert)
SERVER_DOMAIN=192.168.1.7

# Agent self-update
# Public base URL agents use to download packages (the vsay-auth gateway).
# Must be reachable FROM the agent machines.
BACKEND_PUBLIC_URL=http://192.168.1.7:8082
# The version the portal treats as "latest" — bump this each time you run
# `make deploy-binaries` with a new build. Agents reporting a different version
# will be offered the update.
# Fallback only. agent-binaries/VERSION is written by `make deploy-binaries`
# and wins over this, so the version advertised as latest is always the version
# actually available for download. Set this only when packages are served from
# somewhere the backend cannot read.
LATEST_AGENT_VERSION=10-11-2026-5
# Directory the 8 agent packages are served from (defaults to ./agent-binaries)
# AGENT_BINARIES_DIR=./agent-binaries

# Remote desktop (RDP/VNC via guacd)
# Where the backend reaches guacd (guacd container publishes 4822 on the host).
GUACD_ADDR=127.0.0.1:4822
# How the guacd CONTAINER reaches back to this backend's per-session tunnel bridge.
# Must be an address the container can reach — the host's LAN IP is the most reliable
# (host.docker.internal can be flaky on Docker Desktop). Set to this machine's IP.
GUACD_HOST_GATEWAY=192.168.1.7


# openssl req -x509 -newkey rsa:2048 \
#   -keyout certs/server-key.pem -out certs/server-cert.pem \
#   -days 3650 -nodes \
#   -subj "/C=US/ST=State/L=City/O=Vsay/CN=yournewdomain.com" \
#   -addext "subjectAltName=DNS:yournewdomain.com,DNS:localhost,IP:127.0.0.1"


# wxt-log-manager — where agent log batches are forwarded.
#
# Agents still POST /agent/logs to THIS backend, because that is the host in
# their configuration and the CA they pinned at enrolment. This backend no
# longer does the work: it streams the body straight through, unread.
#
# Unset means agents are told to hold their batches (503) rather than being
# told "accepted" for logs that went nowhere.
WXT_LOG_MANAGER_URL=http://localhost:8090

# CONFIG_ENCRYPT_KEY seals the few values this service must store and read
# back — at present only the default account's password, which has to survive
# until a machine that does not exist yet enrols.
#
# Without it the server still runs; it simply refuses to store that password
# and says so in the portal, rather than writing a credential for an account
# on every machine into a collection that backups copy.
#
# At least 16 characters. Changing it makes an already-stored password
# unreadable, which is reported rather than silently creating accounts with
# an empty password.
CONFIG_ENCRYPT_KEY=kaalbhairav123456789
